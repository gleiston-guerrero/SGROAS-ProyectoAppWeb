# =============================================================================
# SGROAS — Variables de Entorno
# =============================================================================
# Copiar a .env y ajustar según el entorno.
# Este archivo está excluido del repositorio vía .gitignore.
# =============================================================================

# --- Base de datos ---
POSTGRES_DB=sgroas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<ROTATED_DB_PASSWORD>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sgroas_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<ROTATED_DB_PASSWORD>

# --- Redis ---
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_REDIS_HOST=redis

# --- JWT ---
APP_JWT_SECRET=<ROTATED_JWT_SECRET_MIN_32_CHARS>
APP_JWT_EXPIRATION_MS=3600000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# --- Cache Redis TTL (segundos) ---
APP_CACHE_DEFAULT_TTL=300

# --- Correo (SMTP): codigos de verificacion y restablecimiento de contrasena ---
# Sin SMTP_HOST la app funciona en MODO CONSOLA (el codigo queda en el log).
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=tucorreo@gmail.com,
# SMTP_PASS=<clave de aplicacion de 16 caracteres generada en tu cuenta Google>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sgroas.com
